// user.prisma — User-related models

model User {
  // Use Clerk user id as the primary key
  id          String   @id
  email       String   @unique
  username    String? // Unique identifier, used in URLs and mentions
  displayName String? // Optional display name (shows instead of username if set)
  imageUrl    String? // Profile picture URL from Clerk
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // Singles-only streak (standalone predictions)
  singlesCurrentStreak Int @default(0)
  singlesLongestStreak Int @default(0)

  // Parlay-leg streak (per winning leg; see parlay spec)
  parlayLegCurrentStreak Int @default(0)
  parlayLegLongestStreak Int @default(0)

  // Largest won parlay by effective leg count (after pushes removed)
  largestParlayWinLegCount Int @default(0)

  predictions      Prediction[]
  parlays          Parlay[]
  ledger           PointsLedger[]
  userAchievements UserAchievement[]
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
