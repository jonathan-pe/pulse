// prediction.prisma — Prediction enum + model

enum PredictionType {
  MONEYLINE
  SPREAD
  TOTAL
}

enum PredictionOutcome {
  WIN
  LOSS
  PUSH
}

model Prediction {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type      PredictionType
  pick      String
  createdAt DateTime       @default(now())
  lockedAt  DateTime?

  // Scoring metadata
  oddsAtPrediction Json? // Snapshot of odds when prediction was made
  processedAt      DateTime? // When scoring was calculated
  outcome          PredictionOutcome? // null = not yet scored; WIN / LOSS / PUSH when processed

  // Allow multiple predictions per game, but not duplicate type+pick combinations
  @@unique([userId, gameId, type, pick])
  @@index([userId, createdAt]) // For daily ordering
  @@index([userId, gameId])
}
